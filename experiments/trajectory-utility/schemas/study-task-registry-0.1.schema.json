{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajpack.dev/schemas/experiments/study-task-registry-0.1.schema.json",
  "title": "trajpack private study task registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "tasks"],
  "properties": {
    "schema_version": {"const": "study-task-registry/0.1"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "task_signature_sha256", "split", "verifier_id", "bindings"],
        "properties": {
          "task_id": {"type": "string", "minLength": 1},
          "task_signature_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "split": {"enum": ["train", "eval"]},
          "verifier_id": {
            "anyOf": [
              {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
              {"type": "null"}
            ]
          },
          "bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["arm", "trace_id", "view_id", "view_sha256", "source_event_ids_sha256"],
              "properties": {
                "arm": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
                "trace_id": {"type": "string", "minLength": 1},
                "view_id": {"type": "string", "minLength": 1},
                "view_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
                "source_event_ids_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
              }
            }
          }
        }
      }
    }
  }
}
