{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajpack.dev/schemas/experiments/study-verifier-manifest-0.1.schema.json",
  "title": "trajpack private study verifier manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "verifiers"],
  "properties": {
    "schema_version": {"const": "study-verifier-manifest/0.1"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "verifiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["verifier_id", "version", "protocol", "artifact_sha256"],
        "properties": {
          "verifier_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "version": {"type": "string", "minLength": 1},
          "protocol": {"type": "string", "minLength": 1},
          "artifact_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        }
      }
    }
  }
}
