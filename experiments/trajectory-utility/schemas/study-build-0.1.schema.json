{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trajpack.dev/schemas/experiments/study-build-0.1.schema.json",
  "title": "trajpack multi-arm study build specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "study_id", "seed", "task_registry", "verifier_manifest", "arms"],
  "properties": {
    "schema_version": {"const": "study-build/0.1"},
    "study_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
    "seed": {"type": "integer", "minimum": 0, "maximum": 9223372036854775807},
    "task_registry": {"type": "string", "minLength": 1},
    "verifier_manifest": {"type": "string", "minLength": 1},
    "arms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "dataset"],
        "properties": {
          "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]{0,63}$"},
          "dataset": {"type": "string", "minLength": 1}
        }
      }
    }
  }
}
